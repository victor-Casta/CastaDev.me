---
import { Image } from "astro:assets";
import resumeIcon from "../assets/icons/resume.svg";
import ItemInformation from "./Item-information.astro";
import locationIcon from "../assets/icons/location.svg";
import profilePhoto from "../assets/images/profile.png";
import worldIcon from "../assets/icons/world.svg";
import hatIcon from "../assets/icons/hat.svg";
import drivenIcon from "../assets/icons/rocket.svg";
import telegramIcon from "../assets/icons/telegram.svg";
import whatsappIcon from "../assets/icons/whatsapp.svg";
import "../styles/Profile.css";
---

<div class="Profile">
  <div class="section-principal">
    <picture class="profile-photo">
      <Image src={profilePhoto} alt={"profile photo"} />
    </picture>
    <div class="name">
      <div class="message__profile">
        <span class="state"></span>
        <p>Available to work</p>
      </div>
      <h2>Victor Arroyave</h2>
      <p class="profession">
        I'm a <span id="animated-text"></span><span id="cursor">_</span>
      </p>
    </div>
    <div class="resume-cv">
      <p>resume</p>
      <div class="icon__resume-cv">
        <Image src={resumeIcon} alt={"resume icon"} />
      </div>
    </div>
  </div>
  <div class="section-information">
    <ItemInformation
      iconInformation={locationIcon}
      titleInformation="Colombia"
    />
    <ItemInformation
      iconInformation={worldIcon}
      titleInformation="Spanish & English"
    />
    <ItemInformation
      iconInformation={hatIcon}
      titleInformation="Software Engineer"
    />
    <ItemInformation
      iconInformation={drivenIcon}
      titleInformation="Driven person"
    />
  </div>
  <div class="section-chat">
    <a
      href="https://t.me/+573193958699"
      class="social-chat telegram-container"
      target="_blank"
    >
      <div class="telegram-icon">
        <Image src={telegramIcon} alt={"telegram icon"} />
      </div>
      <p>Telegram</p>
    </a>
    <a
      href="https://wa.me/573016456893"
      class="social-chat whatsapp-container"
      target="_blank"
    >
      <div class="whatsapp-icon">
        <Image src={whatsappIcon} alt={"whatsapp icon"} />
      </div>
      <p>Whatsapp</p>
    </a>
  </div>
</div>

<script>
  import { gsap } from "gsap";
  import { TextPlugin } from "gsap/TextPlugin";
  gsap.registerPlugin(TextPlugin);
  const words = ["Front-end", "Back-end", "Full-stack", "Developer"];

  const animationDuration = 2;

  gsap.to("#cursor", {
    opacity: 0,
    duration: animationDuration / 4,
    repeat: -1,
    yoyo: true,
    ease: "power1.inOut",
  });

  let tl = gsap.timeline({
    repeat: -1,
  });

  words.forEach((word) => {
    let tlText = gsap.timeline({ repeat: 1, yoyo: true });
    tlText.to("#animated-text", { duration: animationDuration, text: word });
    tl.add(tlText);
  });
</script>
